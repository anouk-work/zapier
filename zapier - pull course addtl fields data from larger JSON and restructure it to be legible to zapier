import json

# Get the course data from Step 6 (webhook response)
course_data_input = input_data.get('course_data', '{}')

# Parse the JSON response if it's a string
if isinstance(course_data_input, str):
    course_data = json.loads(course_data_input)
else:
    course_data = course_data_input

# Navigate to the data object where additional_fields should be
data_obj = course_data.get('data', {})
additional_fields = data_obj.get('additional_fields', [])

# Create a lookup table with field IDs as keys
lookup_table = {}

# Process each additional field
for field in additional_fields:
    field_id = field.get('id')
    field_key = str(field_id)
    
    # Add the complete field object to the lookup table
    lookup_table[field_key] = {
        'id': field.get('id'),
        'value': field.get('value'),
        'title': field.get('title'),
        'type': field.get('type')
    }

# Return both the lookup table and field 9 details
return {
    'lookup_table': lookup_table,
    'all_fields': additional_fields,
    'total_fields': len(additional_fields)
}
